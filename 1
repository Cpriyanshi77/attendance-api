[Unit]
Description=Attendance API (gunicorn)
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/attendance-api
# Put venv bin on PATH so ExecStart uses correct gunicorn/python
Environment="PATH=/home/ubuntu/attendance-api/venv/bin"
# Optional environment variables -- avoid hardcoding secrets in repo
Environment="DB_URL=jdbc:postgresql://127.0.0.1:5432/attendance_db"
Environment="DB_USER=postgres"
# Do NOT put real passwords here in public files; consider systemd-escape or a secrets file
Environment="DB_PASS=password"
ExecStart=/home/ubuntu/attendance-api/venv/bin/gunicorn app:app \
  --bind 0.0.0.0:8082 \
  --workers 3 \
  --access-logfile /var/log/attendance-access.log \
  --error-logfile /var/log/attendance-error.log \
  --log-level info

Restart=on-failure
RestartSec=5s
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target

